<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background: linear-gradient(135deg, #8B5CF6, #6D28D9);
        color: white;
        padding: 20px;
        border-radius: 8px 8px 0 0;
        text-align: center;
      }
      .header h1 {
        margin: 0;
        font-size: 24px;
      }
      .content {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-top: none;
        padding: 20px;
        border-radius: 0 0 8px 8px;
      }
      .info-grid {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 10px;
        margin: 20px 0;
      }
      .label {
        font-weight: 600;
        color: #6B7280;
      }
      .value {
        color: #1F2937;
      }
      .error-message {
        background: #FEF2F2;
        border-left: 4px solid #EF4444;
        padding: 15px;
        margin: 20px 0;
        border-radius: 4px;
      }
      .error-message code {
        background: #FEE2E2;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 14px;
        color: #991B1B;
      }
      .backtrace {
        background: #F9FAFB;
        border: 1px solid #E5E7EB;
        padding: 15px;
        border-radius: 4px;
        overflow-x: auto;
        margin: 20px 0;
      }
      .backtrace pre {
        margin: 0;
        font-size: 12px;
        color: #4B5563;
        white-space: pre-wrap;
        word-wrap: break-word;
      }
      .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
      }
      .badge-production {
        background: #FEE2E2;
        color: #991B1B;
      }
      .badge-staging {
        background: #FEF3C7;
        color: #92400E;
      }
      .badge-development {
        background: #D1FAE5;
        color: #065F46;
      }
      .badge-ios {
        background: #000000;
        color: #FFFFFF;
      }
      .badge-android {
        background: #3DDC84;
        color: #000000;
      }
      .badge-api {
        background: #DBEAFE;
        color: #1E40AF;
      }
      .button {
        display: inline-block;
        background: #8B5CF6;
        color: white;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        margin: 20px 0;
      }
      .button:hover {
        background: #7C3AED;
      }
      .footer {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #E5E7EB;
        color: #6B7280;
        font-size: 12px;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1><%= red_t("red.mailers.error_alert.heading") %></h1>
    </div>

    <div class="content">
      <div class="info-grid">
        <div class="label"><%= red_t("red.mailers.error_alert.labels.application") %>:</div>
        <div class="value"><strong><%= @error_log.application&.name || red_t("red.mailers.shared.unknown_application") %></strong></div>

        <div class="label"><%= red_t("red.mailers.error_alert.labels.error_type") %>:</div>
        <div class="value"><code><%= @error_log.error_type %></code></div>

        <% if @error_log.platform.present? %>
          <div class="label"><%= red_t("red.mailers.error_alert.labels.platform") %>:</div>
          <div class="value">
            <span class="badge badge-<%= @error_log.platform.downcase %>">
              <%= @error_log.platform %>
            </span>
          </div>
        <% end %>

        <div class="label"><%= red_t("red.mailers.error_alert.labels.occurred_at") %>:</div>
        <div class="value"><%= red_mail_time(@error_log.occurred_at) %></div>

        <% if @error_log.user_id.present? %>
          <div class="label"><%= red_t("red.mailers.error_alert.labels.user_id") %>:</div>
          <div class="value"><%= @error_log.user_id %></div>
        <% end %>

        <% if @error_log.ip_address.present? %>
          <div class="label"><%= red_t("red.mailers.error_alert.labels.ip_address") %>:</div>
          <div class="value"><%= @error_log.ip_address %></div>
        <% end %>

        <% if @error_log.request_url.present? %>
          <div class="label"><%= red_t("red.mailers.error_alert.labels.request_url") %>:</div>
          <div class="value"><%= @error_log.request_url %></div>
        <% end %>
      </div>

      <div class="error-message">
        <strong><%= red_t("red.mailers.error_alert.labels.message") %>:</strong><br/>
        <code><%= @error_log.message %></code>
      </div>

      <% if @error_log.backtrace.present? %>
        <% backtrace_lines = @error_log.backtrace.split("\n").first(10) %>
        <div class="backtrace">
          <strong><%= red_tp("red.mailers.error_alert.stack_trace", count: backtrace_lines.length) %>:</strong>
          <%# Backtrace content is diagnostic output and is never translated. %>
          <pre><%= backtrace_lines.join("\n") %></pre>
        </div>
      <% end %>

      <div style="text-align: center;">
        <a href="<%= @dashboard_url %>" class="button">
          <%= red_t("red.mailers.error_alert.view_details") %>
        </a>
      </div>

      <div class="footer">
        <p>
          <%= red_t("red.mailers.error_alert.footer", product: red_t("red.mailers.shared.product_name")) %><br/>
          <%= red_t("red.mailers.error_alert.labels.error_id") %>: <%= @error_log.id %>
        </p>
      </div>
    </div>
  </body>
</html>
