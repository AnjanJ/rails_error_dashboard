<% content_for :page_title, red_t("red.errors.index.title") %>

<!-- Subscribe to Turbo Stream updates (only if Turbo Streams + ActionCable pubsub are available) -->
<% if defined?(Turbo::StreamsHelper) && defined?(ActionCable) && respond_to?(:turbo_stream_from) && RailsErrorDashboard::Services::ErrorBroadcaster.available? %>
  <%= turbo_stream_from "error_list" %>
<% end %>

<%
  # Value -> label lookups for the machine-valued filters.
  #
  # These previously went through humanize/titleize/capitalize, which apply
  # English morphology to an identifier ("last_7_days" -> "Last 7 days") and
  # produce nonsense in any other language. Each known value now has a key, and
  # an unrecognised one falls back to its raw value rather than raising — a
  # hand-edited query string must never break the page.
  #
  # They live here as lambdas because P2-T2's scope is this view and the row
  # partial; the helpers are P2-T10's task, which can promote these as-is.
  timeframe_label = ->(value) do
    red_t("red.errors.index.filters.timeframes.#{value}", default: value.to_s)
  end
  frequency_label = ->(value) do
    red_t("red.errors.index.filters.frequencies.#{value}", default: value.to_s)
  end
  severity_label = ->(value) do
    red_t("red.common.severity.#{value}", default: value.to_s)
  end
  status_label = ->(value) do
    red_t("red.errors.index.filters.status.#{value}", default: value.to_s)
  end
%>
<div data-controller="loading">
  <%# flex-wrap is load-bearing, not cosmetic: this row pairs the page title
      with a fully-formatted timestamp, and every locale but English spells the
      month out in full ("22 августа 2026, 14:05:03" against "August 22, 2026").
      Without wrapping, the row is forced onto one line and overflows a 375px
      viewport in de/fr/ru while fitting in English — measured at 406-469px in
      spec/system/p7_layout_qa_spec.rb. Wrapping lets the timestamp drop below
      the title instead of pushing the page wider. %>
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4);">
    <h1 style="font-size: 20px; font-weight: 700; margin: 0;"><%= red_t("red.errors.index.title") %></h1>
    <span style="font-size: 12px; color: var(--text-tertiary);">
      <%= red_t("red.errors.index.last_updated_html", time: local_time(Time.current, format: :full)) %>
      <% if defined?(Turbo::StreamsHelper) && defined?(ActionCable) && respond_to?(:turbo_stream_from) && RailsErrorDashboard::Services::ErrorBroadcaster.available? %>
        <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; font-size: 10px; font-weight: 600; border-radius: var(--radius-full); background: var(--status-success-bg); color: var(--status-success); margin-left: 6px;">
          <i class="bi bi-broadcast" style="font-size: 10px;"></i> <%= red_t("red.errors.index.live") %>
        </span>
      <% end %>
    </span>
  </div>

  <!-- Hidden skeleton placeholders for loading state management -->
  <div class="loading-skeleton" data-loading-target="skeleton" style="display: none;">
    <div style="display: flex; gap: var(--space-4); margin-bottom: var(--space-4);">
      <div class="skeleton skeleton-card" style="flex: 1;"></div>
      <div class="skeleton skeleton-card" style="flex: 1;"></div>
      <div class="skeleton skeleton-card" style="flex: 1;"></div>
    </div>
  </div>

  <!-- Summary line + batch actions -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
    <span style="font-size: 13px; color: var(--text-secondary);">
      <%= red_tp("red.errors.index.summary.errors_html", count: @pagy.count,
            value: tag.strong(@pagy.count, style: "color: var(--text-primary);")) %>
      <span style="margin: 0 6px; color: var(--border-secondary);">&middot;</span>
      <%= red_t("red.errors.index.summary.unresolved_html",
            value: tag.strong(@stats[:unresolved], style: "color: var(--status-critical);")) %>
      <span style="margin: 0 6px; color: var(--border-secondary);">&middot;</span>
      <% if params[:timeframe].present? %>
        <%= timeframe_label.call(params[:timeframe]) %>
      <% else %>
        <%= red_t("red.errors.index.summary.all_time") %>
      <% end %>
    </span>
  </div>

  <!-- Spike Detection Alert -->
  <% if @stats[:spike_detected] %>
    <div class="alert alert-warning" role="alert" style="display: flex; align-items: center; gap: 10px; padding: var(--space-3) var(--space-5); background: var(--status-caution-bg); border: 1px solid var(--status-caution); border-radius: var(--radius-md); margin-bottom: var(--space-4); font-size: 13px; color: var(--text-primary);">
      <i class="bi bi-exclamation-triangle-fill" style="font-size: 18px; color: var(--status-caution); flex-shrink: 0;"></i>
      <div>
        <strong>
          <% case @stats[:spike_info][:severity] %>
          <% when :critical %>
            <%= red_t("red.errors.index.spike.critical") %>
          <% when :high %>
            <%= red_t("red.errors.index.spike.high") %>
          <% when :elevated %>
            <%= red_t("red.errors.index.spike.elevated") %>
          <% end %>
        </strong>
        <span style="color: var(--text-secondary);">
          <strong><%= red_tp("red.errors.index.spike.today", count: @stats[:spike_info][:today_count]) %></strong>
          <%= red_t("red.errors.index.spike.average", avg: @stats[:spike_info][:avg_count]) %> &mdash;
          <strong><%= red_t("red.errors.index.spike.multiplier", multiplier: @stats[:spike_info][:multiplier]) %></strong>
        </span>
      </div>
    </div>
  <% end %>

  <!-- Filter bar -->
  <%= form_with url: errors_path, method: :get, data: { turbo: false, action: "submit->loading#submit" }, id: "filter-form" do %>
    <% if params[:reopened].present? %>
      <%= hidden_field_tag :reopened, params[:reopened] %>
    <% end %>
    <div style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-primary); border-radius: var(--radius-md); border: 1px solid var(--border-primary); margin-bottom: var(--space-4); flex-wrap: wrap;">
      <!-- Search -->
      <div style="position: relative; flex: 1 1 200px; min-width: 160px;">
        <i class="bi bi-search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 13px; color: var(--text-tertiary);"></i>
        <%= text_field_tag :search, params[:search], placeholder: red_t("red.errors.index.filters.search_placeholder"), style: "width: 100%; padding: 6px 10px 6px 30px; font-size: 13px; border: 1px solid var(--border-primary); border-radius: var(--radius-sm); background: var(--surface-base); color: var(--text-primary); outline: none; font-family: var(--font-sans);" %>
      </div>

      <div style="width: 1px; height: 24px; background: var(--border-primary);"></div>

      <!-- Status pills -->
      <div style="display: flex; gap: 4px; flex-wrap: wrap;">
        <%
          current_status = params[:status]
          is_unresolved_only = params[:unresolved] != "false" && params[:unresolved] != "0"
        %>
        <%= link_to errors_path(app_context.merge(unresolved: '0')), class: "btn filter-pill #{current_status.blank? && !is_unresolved_only ? 'active btn-primary' : 'btn-outline-primary'}", style: "text-decoration: none;" do %><%= red_t("red.errors.index.filters.status.all") %><% end %>
        <%= link_to errors_path(app_context.merge(unresolved: '1')), class: "btn filter-pill #{is_unresolved_only && current_status.blank? ? 'active btn-primary' : 'btn-outline-primary'}", style: "text-decoration: none;" do %><%= red_t("red.errors.index.filters.status.unresolved") %> <span style="font-size: 11px; opacity: 0.7;"><%= @stats[:unresolved] %></span><% end %>
        <%= link_to errors_path(app_context.merge(status: 'resolved', unresolved: '0')), class: "btn filter-pill #{current_status == 'resolved' ? 'active btn-primary' : 'btn-outline-primary'}", style: "text-decoration: none;" do %><%= red_t("red.errors.index.filters.status.resolved") %><% end %>
        <%= link_to errors_path(app_context.merge(assigned_to: '__assigned__', unresolved: '0')), class: "btn filter-pill #{params[:assigned_to] == '__assigned__' ? 'active btn-primary' : 'btn-outline-primary'}", style: "text-decoration: none;" do %><%= red_t("red.errors.index.filters.status.assigned") %><% end %>
        <%= link_to errors_path(app_context.merge(reopened: 'true', unresolved: '0')), class: "btn filter-pill #{params[:reopened] == 'true' ? 'active btn-primary' : 'btn-outline-primary'}", style: "text-decoration: none;" do %><%= red_t("red.errors.index.filters.status.reopened") %><% end %>
      </div>

      <div style="width: 1px; height: 24px; background: var(--border-primary);"></div>

      <!-- Severity pills -->
      <%# flex-wrap matches the status-chip row above it. Five severity chips
          fit one line in English ("Any Critical High Medium Low") but not in a
          locale that expands: Russian renders "Любая важность Критическая
          Высокая Средняя Низкая" and pushed this row to 426px inside a 375px
          viewport. Pinned by spec/system/p7_layout_qa_spec.rb. %>
      <div style="display: flex; gap: 4px; flex-wrap: wrap;">
        <% current_severity = params[:severity] %>
        <%= link_to errors_path(permitted_filter_params.except(:severity)), class: "filter-pill #{current_severity.blank? ? 'active' : ''}", style: "text-decoration: none;" do %><%= red_t("red.errors.index.filters.severity.any") %><% end %>
        <% %w[critical high medium low].each do |sev| %>
          <%= link_to errors_path(permitted_filter_params.merge(severity: sev)), class: "filter-pill #{current_severity == sev ? 'active' : ''}", style: "text-decoration: none;" do %><%= severity_label.call(sev) %><% end %>
        <% end %>
      </div>

      <!-- Advanced filters toggle -->
      <div style="width: 1px; height: 24px; background: var(--border-primary);"></div>
      <button type="button" data-red-action="toggle-display" data-red-target="#advanced-filters" data-red-display="flex" class="filter-pill" style="border: none;">
        <i class="bi bi-sliders"></i> <%= red_t("red.errors.index.filters.more") %>
      </button>
    </div>

    <!-- Advanced filters -->
    <div id="advanced-filters" style="display: none; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--surface-primary); border-radius: var(--radius-md); border: 1px solid var(--border-primary);">
      <% if @applications.size > 1 %>
        <%= select_tag :application_id, options_for_select([[red_t("red.errors.index.filters.all_apps"), '']] + @applications, params[:application_id]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      <% end %>
      <% if @platforms.size > 1 %>
        <%= select_tag :platform, options_for_select([[red_t("red.errors.index.filters.all_platforms"), '']] + @platforms.map { |p| [p, p] }, params[:platform]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      <% end %>
      <% if @environments.size > 1 %>
        <%= select_tag :environment, options_for_select([[red_t("red.errors.index.filters.all_environments"), '']] + @environments.map { |e| [e, e] }, params[:environment]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      <% end %>
      <%= select_tag :error_type, options_for_select([[red_t("red.errors.index.filters.all_types"), '']] + @error_types.map { |t| [t, t] }, params[:error_type]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      <%
        # Built from the same keys the active chips read, so a label can never
        # differ between the select and the chip it produces.
        timeframe_options = %w[last_hour today yesterday last_7_days last_30_days last_90_days]
          .map { |value| [ timeframe_label.call(value), value ] }
        frequency_options = %w[once few frequent very_frequent recurring]
          .map { |value| [ frequency_label.call(value), value ] }
      %>
      <%= select_tag :timeframe, options_for_select([[red_t("red.errors.index.filters.all_timeframes"), '']] + timeframe_options, params[:timeframe]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      <%= select_tag :frequency, options_for_select([[red_t("red.errors.index.filters.all_frequencies"), '']] + frequency_options, params[:frequency]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      <%= select_tag :priority_level, options_for_select([[red_t("red.errors.index.filters.all_priorities"), '']] + RailsErrorDashboard::ErrorLog.priority_options(include_emoji: true), params[:priority_level]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      <%= select_tag :assigned_to, options_for_select([[red_t("red.errors.index.filters.all_assignments"), ''], [red_t("red.errors.index.filters.unassigned"), '__unassigned__'], [red_t("red.errors.index.filters.assigned"), '__assigned__']], params[:assigned_to]), class: "form-select", id: "assigned_to_filter", style: "width: auto; min-width: 120px;" %>
      <div id="assignee_name_filter" style="<%= params[:assigned_to] == '__assigned__' ? '' : 'display: none;' %>">
        <% assignees = defined?(@assignees) ? @assignees : [] %>
        <%= select_tag :assignee_name, options_for_select([[red_t("red.errors.index.filters.all_assignees"), '']] + assignees.map { |name| [name, name] }, params[:assignee_name]), class: "form-select", style: "width: auto; min-width: 120px;" %>
      </div>

      <div style="display: flex; align-items: center; gap: var(--space-4); font-size: 12px; color: var(--text-secondary);">
        <label style="display: flex; align-items: center; gap: 4px; font-weight: 400;">
          <%
            is_checked = if params[:unresolved].nil?
              true
            else
              params[:unresolved] != "false" && params[:unresolved] != "0"
            end
          %>
          <%= check_box_tag :unresolved, "1", is_checked, class: "form-check-input", id: "unresolved_checkbox", style: "width: 14px; height: 14px;" %>
          <%= red_t("red.errors.index.filters.unresolved_only") %>
        </label>
        <label style="display: flex; align-items: center; gap: 4px; font-weight: 400;">
          <%= check_box_tag :hide_snoozed, "1", params[:hide_snoozed] == "1", class: "form-check-input", style: "width: 14px; height: 14px;" %>
          <%= red_t("red.errors.index.filters.hide_snoozed") %>
        </label>
        <label style="display: flex; align-items: center; gap: 4px; font-weight: 400;">
          <%= check_box_tag :hide_muted, "1", params[:hide_muted] == "1", class: "form-check-input", style: "width: 14px; height: 14px;" %>
          <%= red_t("red.errors.index.filters.hide_muted") %>
        </label>
      </div>

      <div style="display: flex; gap: 6px; margin-left: auto;">
        <%= submit_tag red_t("red.errors.index.filters.apply"), class: "btn btn-primary btn-sm", data: { loading_target: "submitButton" } %>
        <%= link_to red_t("red.errors.index.filters.clear"), errors_path, class: "btn btn-sm", style: "font-size: 12px;" %>
      </div>
    </div>
  <% end %>

  <!-- Active Filter Pills -->
  <%
    # Each chip is an interpolated key, never a concatenation — the label and
    # its value are not always in that order across languages. Search terms and
    # application, platform and type names are free-form user data and are
    # interpolated verbatim, never translated.
    active_filters = []
    active_filters << { label: red_t("red.errors.index.filters.chips.search", value: params[:search]), param: :search } if params[:search].present?
    if params[:application_id].present? && defined?(@applications)
      app_name = @applications.find { |name, id| id.to_s == params[:application_id].to_s }&.first
      active_filters << { label: red_t("red.errors.index.filters.chips.application", value: app_name), param: :application_id } if app_name
    end
    active_filters << { label: red_t("red.errors.index.filters.chips.platform", value: params[:platform]), param: :platform } if params[:platform].present?
    active_filters << { label: red_t("red.errors.index.filters.chips.environment", value: params[:environment]), param: :environment } if params[:environment].present?
    active_filters << { label: red_t("red.errors.index.filters.chips.error_type", value: params[:error_type]), param: :error_type } if params[:error_type].present?
    active_filters << { label: red_t("red.errors.index.filters.chips.severity", value: severity_label.call(params[:severity])), param: :severity } if params[:severity].present?
    active_filters << { label: red_t("red.errors.index.filters.chips.timeframe", value: timeframe_label.call(params[:timeframe])), param: :timeframe } if params[:timeframe].present?
    active_filters << { label: red_t("red.errors.index.filters.chips.frequency", value: frequency_label.call(params[:frequency])), param: :frequency } if params[:frequency].present?
    active_filters << { label: red_t("red.errors.index.filters.chips.status", value: status_label.call(params[:status])), param: :status } if params[:status].present?
    if params[:priority_level].present?
      # priority_level is the integer key (3=Critical/P0, 0=Low/P3); look up the short_label
      # rather than interpolating the raw integer, which inverts the P-number.
      # P0-P3 are identifiers, not words, and stay untranslated.
      priority_data = RailsErrorDashboard::ErrorLog::PRIORITY_LEVELS[params[:priority_level].to_i]
      priority_short = priority_data ? priority_data[:short_label] : "P?"
      active_filters << { label: red_t("red.errors.index.filters.chips.priority", value: priority_short), param: :priority_level }
    end
    if params[:assigned_to] == '__unassigned__'
      active_filters << { label: red_t("red.errors.index.filters.unassigned"), param: :assigned_to }
    elsif params[:assigned_to] == '__assigned__'
      active_filters << { label: red_t("red.errors.index.filters.assigned"), param: :assigned_to }
    end
  %>
  <% if active_filters.any? %>
    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: var(--space-4); font-size: 12px;">
      <span style="color: var(--text-tertiary); font-weight: 500;"><%= red_t("red.errors.index.filters.active_label") %></span>
      <% active_filters.each do |filter| %>
        <%= link_to errors_path(permitted_filter_params.except(filter[:param])), class: "filter-pill active", style: "text-decoration: none; font-size: 11px; padding: 3px 8px;", "aria-label": red_t("red.errors.index.filters.chips.remove") do %>
          <%= filter[:label] %> <i class="bi bi-x" style="font-size: 12px;"></i>
        <% end %>
      <% end %>
      <%= link_to errors_path, style: "color: var(--text-tertiary); font-size: 11px;" do %><%= red_t("red.errors.index.filters.clear_all") %><% end %>
    </div>
  <% end %>

  <!-- Error Table -->
  <div class="card" style="overflow: hidden;">
    <% if @errors.any? %>
      <!-- Batch action toolbar (shown when one or more errors are selected). Sits above the table
           so it doesn't disrupt the table's column widths the way a colspan thead row does. -->
      <div id="batch-toolbar" style="display: none; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border-primary); background: var(--surface-secondary);">
        <%= form_with url: batch_action_errors_path, method: :post, id: "batch-form", style: "display: flex; gap: 8px; align-items: center; flex-wrap: wrap;" do |f| %>
          <% if params[:application_id].present? %>
            <%= hidden_field_tag :application_id, params[:application_id] %>
          <% end %>
          <input type="checkbox" id="select-all-batch" class="form-check-input" style="accent-color: var(--accent); margin: 0;" checked>
          <span id="selected-count" style="font-size: 13px; font-weight: 600; color: var(--text-primary); margin-right: var(--space-2);"></span>
          <%= button_tag type: "submit", name: "action_type", value: "resolve", class: "btn btn-sm", style: "padding: 4px 12px; font-size: 12px;" do %>
            <i class="bi bi-check-circle"></i> <%= red_t("red.errors.index.batch.resolve") %>
          <% end %>
          <%= button_tag type: "submit", name: "action_type", value: "delete", class: "btn btn-sm", style: "padding: 4px 12px; font-size: 12px; color: var(--status-critical);", data: { confirm: red_t("red.errors.index.batch.confirm_delete") } do %>
            <i class="bi bi-trash"></i> <%= red_t("red.errors.index.batch.delete") %>
          <% end %>
        <% end %>
      </div>
      <div data-loading-target="content">
        <div style="overflow-x: auto;">
        <table class="table table-hover" style="margin-bottom: 0; width: 100%; table-layout: fixed;">
          <thead>
            <tr id="thead-columns" style="border-bottom: 1px solid var(--border-primary);">
              <th style="width: 36px; padding: var(--space-3) var(--space-4); text-align: center;">
                <input type="checkbox" id="select-all" class="form-check-input" style="accent-color: var(--accent);" aria-label="<%= red_t("red.errors.index.columns.select_all") %>">
              </th>
              <th style="padding: var(--space-3) var(--space-4); text-align: left;"><%= red_t("red.errors.index.columns.error") %></th>
              <th style="padding: var(--space-3) var(--space-4); text-align: left; width: 100px;"><%= red_t("red.errors.index.columns.status") %></th>
              <th style="padding: var(--space-3) var(--space-4); text-align: right; width: 70px;"><%= red_t("red.errors.index.columns.events") %></th>
              <th style="padding: var(--space-3) var(--space-4); text-align: right; width: 55px;"><%= red_t("red.errors.index.columns.users") %></th>
              <th style="padding: var(--space-3) var(--space-4); text-align: right; width: 85px;"><%= red_t("red.errors.index.columns.last_seen") %></th>
              <% if @applications.size > 1 && params[:application_id].blank? %>
                <th style="padding: var(--space-3) var(--space-4); width: 100px;"><%= red_t("red.errors.index.columns.application") %></th>
              <% end %>
              <% if @platforms.size > 1 %>
                <th style="padding: var(--space-3) var(--space-4); width: 100px;"><%= red_t("red.errors.index.columns.platform") %></th>
              <% end %>
              <% if @environments.size > 1 %>
                <th style="padding: var(--space-3) var(--space-4); width: 110px;"><%= red_t("red.errors.index.columns.environment") %></th>
              <% end %>
            </tr>
          </thead>
          <tbody id="error_list">
            <% @errors.each do |error| %>
              <%= render "error_row", error: error, show_platform: @platforms.size > 1, show_environment: @environments.size > 1, show_application: (@applications.size > 1 && params[:application_id].blank?) %>
            <% end %>
          </tbody>
        </table>
        </div>

        <!-- Pagination -->
        <% if @pagy.pages > 1 %>
          <div style="padding: var(--space-4); border-top: 1px solid var(--border-primary); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3);">
            <span style="font-size: 12px; color: var(--text-tertiary);"><%= red_t("red.errors.index.pagination", from: @pagy.from, to: @pagy.to, count: @pagy.count) %></span>
            <div><%== @pagy.series_nav(:bootstrap) %></div>
          </div>
        <% end %>
      </div>

      <div class="loading-skeleton" data-loading-target="skeleton">
        <div style="padding: var(--space-4);">
          <% 5.times do %>
            <div class="skeleton skeleton-row" style="margin-bottom: 2px;"></div>
          <% end %>
        </div>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="red-empty-state">
        <% if params[:search].present? || params[:error_type].present? || params[:severity].present? %>
          <div class="red-empty-state-icon"><i class="bi bi-funnel"></i></div>
          <div class="red-empty-state-title"><%= red_t("red.errors.index.empty.filtered_title") %></div>
          <div class="red-empty-state-message"><%= red_t("red.errors.index.empty.filtered_message") %></div>
          <%= link_to errors_path, class: "red-empty-state-cta" do %><i class="bi bi-x-circle"></i> <%= red_t("red.errors.index.empty.filtered_cta") %><% end %>
        <% else %>
          <div class="red-empty-state-icon" style="background: var(--status-success-bg); color: var(--status-success);"><i class="bi bi-check-lg"></i></div>
          <div class="red-empty-state-title"><%= red_t("red.errors.index.empty.clear_title") %></div>
          <div class="red-empty-state-message"><%= red_t("red.errors.index.empty.clear_message") %></div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%= red_javascript_tag do %>
document.addEventListener('DOMContentLoaded', function() {
  var selectAllCheckbox = document.getElementById('select-all');
  var selectAllBatchCheckbox = document.getElementById('select-all-batch');
  var batchToolbar = document.getElementById('batch-toolbar');
  var selectedCountSpan = document.getElementById('selected-count');
  var batchForm = document.getElementById('batch-form');

  function getErrorCheckboxes() {
    return document.querySelectorAll('.error-checkbox');
  }

  function updateBatchToolbar() {
    var checkedBoxes = document.querySelectorAll('.error-checkbox:checked');
    var count = checkedBoxes.length;
    var boxes = getErrorCheckboxes();
    var allChecked = boxes.length > 0 && Array.from(boxes).every(function(cb) { return cb.checked; });
    var someChecked = Array.from(boxes).some(function(cb) { return cb.checked; });

    if (count > 0) {
      if (batchToolbar) batchToolbar.style.display = '';
      if (selectedCountSpan) selectedCountSpan.textContent = window.redT('js.selected', { count: count });
      if (selectAllBatchCheckbox) {
        selectAllBatchCheckbox.checked = allChecked;
        selectAllBatchCheckbox.indeterminate = someChecked && !allChecked;
      }
    } else {
      if (batchToolbar) batchToolbar.style.display = 'none';
    }

    if (selectAllCheckbox) {
      selectAllCheckbox.checked = allChecked;
      selectAllCheckbox.indeterminate = someChecked && !allChecked;
    }
  }

  function handleSelectAll(checked) {
    getErrorCheckboxes().forEach(function(cb) { cb.checked = checked; });
    updateBatchToolbar();
  }

  if (selectAllCheckbox) {
    selectAllCheckbox.addEventListener('change', function() {
      handleSelectAll(selectAllCheckbox.checked);
    });
  }

  if (selectAllBatchCheckbox) {
    selectAllBatchCheckbox.addEventListener('change', function() {
      handleSelectAll(selectAllBatchCheckbox.checked);
    });
  }

  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('error-checkbox')) {
      updateBatchToolbar();
    }
  });

  if (batchForm) {
    batchForm.addEventListener('submit', function(e) {
      var checkedBoxes = document.querySelectorAll('.error-checkbox:checked');
      if (checkedBoxes.length === 0) { e.preventDefault(); return false; }
      checkedBoxes.forEach(function(cb) {
        var input = document.createElement('input');
        input.type = 'hidden'; input.name = 'error_ids[]'; input.value = cb.value;
        batchForm.appendChild(input);
      });
    });
  }

  // Turbo Stream animations
  document.addEventListener('turbo:before-stream-render', function(event) {
    var target = event.detail.newStream.target;
    var action = event.detail.newStream.action;
    if (action === 'prepend' && target === 'error_list') {
      setTimeout(function() {
        var firstRow = document.querySelector('#error_list tr:first-child');
        if (firstRow) {
          firstRow.style.background = 'var(--status-success-bg)';
          setTimeout(function() { firstRow.style.background = ''; }, 3000);
        }
      }, 10);
    }
  });

  // Scroll position preservation
  var scrollPos = sessionStorage.getItem('scrollPos');
  if (scrollPos) { window.scrollTo(0, parseInt(scrollPos)); sessionStorage.removeItem('scrollPos'); }

  var filterForm = document.getElementById('filter-form');
  if (filterForm) {
    filterForm.addEventListener('submit', function() {
      sessionStorage.setItem('scrollPos', window.pageYOffset);
      var unresolvedCb = document.getElementById('unresolved_checkbox');
      if (unresolvedCb && !unresolvedCb.checked) {
        var hidden = document.createElement('input');
        hidden.type = 'hidden'; hidden.name = 'unresolved'; hidden.value = '0';
        filterForm.appendChild(hidden);
        unresolvedCb.disabled = true;
      }
    });
  }

  // Tab title with unresolved count
  var unresolvedCount = <%= @stats[:unresolved] || 0 %>;
  if (unresolvedCount > 0) { document.title = '(' + unresolvedCount + ') ' + document.title; }

  // Toggle assignee name filter visibility
  var assignedToFilter = document.getElementById('assigned_to_filter');
  var assigneeNameFilter = document.getElementById('assignee_name_filter');
  if (assignedToFilter && assigneeNameFilter) {
    assignedToFilter.addEventListener('change', function() {
      assigneeNameFilter.style.display = this.value === '__assigned__' ? '' : 'none';
    });
  }
});
<% end %>
