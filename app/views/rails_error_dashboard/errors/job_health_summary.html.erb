<% content_for :page_title, red_t("red.health.job.title") %>

<div>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size: 20px; font-weight: 700; margin: 0;">
      <i class="bi bi-cpu me-2"></i>
      <%= red_t("red.health.job.title") %>
    </h1>

    <div class="btn-group" role="group">
      <%= link_to job_health_summary_errors_path(days: 7), class: "btn btn-sm #{@days == 7 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.7") %>
      <% end %>
      <%= link_to job_health_summary_errors_path(days: 30), class: "btn btn-sm #{@days == 30 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.30") %>
      <% end %>
      <%= link_to job_health_summary_errors_path(days: 90), class: "btn btn-sm #{@days == 90 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.90") %>
      <% end %>
    </div>
  </div>

  <% if @errors_with_jobs == 0 %>
    <div class="red-empty-state">
      <div class="red-empty-state-icon" style="background: var(--status-success-bg); color: var(--status-success);"><i class="bi bi-check-lg"></i></div>
      <div class="red-empty-state-title"><%= red_t("red.health.job.empty.title") %></div>
      <p class="text-muted">
        <%= red_t("red.health.job.empty.message", days: @days) %>
      </p>
      <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body text-start">
          <h6><%= red_t("red.health.job.empty.how_it_works") %></h6>
          <ul class="mb-0">
            <li><%= red_t("red.health.job.empty.step_enable_html") %></li>
            <li><%= red_t("red.health.job.empty.step_capture") %></li>
            <li><%= red_t("red.health.job.empty.step_collected") %></li>
            <li><%= red_t("red.health.job.empty.step_sort") %></li>
          </ul>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-info"><%= @errors_with_jobs %></div>
            <small class="text-muted"><%= red_t("red.health.job.stats.errors_with_jobs") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-center">
          <div class="card-body">
            <% failed_color = @total_failed > 0 ? "danger" : "success" %>
            <div class="display-6 text-<%= failed_color %>"><%= @total_failed %></div>
            <small class="text-muted"><%= red_t("red.health.job.stats.total_failed") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-secondary"><%= @adapters_detected.size %></div>
            <small class="text-muted"><%= red_t("red.health.job.stats.adapters_detected") %></small>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="bi bi-cpu text-info me-2"></i>
          <%= red_t("red.health.job.table.title") %>
          <span class="badge bg-info"><%= @errors_with_jobs %></span>
        </h5>
        <small class="text-muted"><%== @pagy.info_tag %></small>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th width="100"><%= red_t("red.health.job.table.column_error") %></th>
                <th width="120"><%= red_t("red.health.job.table.column_adapter") %></th>
                <th width="80"><%= red_t("red.health.job.table.column_failed") %></th>
                <th width="120"><%= red_t("red.health.job.table.column_queued") %></th>
                <th><%= red_t("red.health.job.table.column_other_stats") %></th>
                <th width="140"><%= red_t("red.health.job.table.column_last_seen") %></th>
              </tr>
            </thead>
            <tbody>
              <% @entries.each do |entry| %>
                <tr>
                  <td><%= link_to "##{entry[:error_id]}", error_path(entry[:error_id]), class: "text-decoration-none" %></td>
                  <td><span class="badge bg-secondary"><%= entry[:adapter] %></span></td>
                  <td>
                    <% failed = entry[:failed] || entry[:errored] || 0 %>
                    <% if failed > 0 %>
                      <span class="badge bg-danger"><%= failed %></span>
                    <% else %>
                      <span class="text-success">0</span>
                    <% end %>
                  </td>
                  <td>
                    <% case entry[:adapter] %>
                    <% when "sidekiq" %>
                      <%= entry[:enqueued] %> <%= red_t("red.health.job.table.enqueued") %>
                    <% when "solid_queue" %>
                      <%= entry[:ready] %> <%= red_t("red.health.job.table.ready") %>
                    <% when "good_job" %>
                      <%= entry[:queued] %> <%= red_t("red.health.job.table.queued") %>
                    <% end %>
                  </td>
                  <td>
                    <small class="text-muted">
                      <% case entry[:adapter] %>
                      <% when "sidekiq" %>
                        <%= red_t("red.health.job.table.other_stats_sidekiq", dead: entry[:dead], retry: entry[:retry], workers: entry[:workers]) %>
                      <% when "solid_queue" %>
                        <%= red_t("red.health.job.table.other_stats_solid_queue", claimed: entry[:claimed], blocked: entry[:blocked], scheduled: entry[:scheduled]) %>
                      <% when "good_job" %>
                        <%= red_t("red.health.job.table.other_stats_good_job", finished: entry[:finished]) %>
                      <% end %>
                    </small>
                  </td>
                  <td><%= local_time_ago(entry[:occurred_at]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer border-top d-flex justify-content-between align-items-center">
        <div>
          <small class="text-muted">
            <i class="bi bi-lightbulb text-warning"></i> <%= red_t("red.health.job.table.tip") %>
          </small>
          <small class="ms-3">
            <a href="https://guides.rubyonrails.org/active_job_basics.html" target="_blank" rel="noopener" class="text-decoration-none">
              <i class="bi bi-book"></i> <%= red_t("red.health.job.table.guide_link") %> <i class="bi bi-box-arrow-up-right" style="font-size: 0.7em;"></i>
            </a>
          </small>
        </div>
        <div>
          <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
        </div>
      </div>
    </div>
  <% end %>
</div>
