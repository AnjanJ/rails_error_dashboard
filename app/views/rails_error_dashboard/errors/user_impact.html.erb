<% content_for :page_title, red_t("red.analytics.user_impact.title") %>

<div>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size: 20px; font-weight: 700; margin: 0;">
      <i class="bi bi-people me-2"></i>
      <%= red_t("red.analytics.user_impact.title") %>
    </h1>

    <div class="btn-group" role="group">
      <%= link_to user_impact_errors_path(days: 7), class: "btn btn-sm #{@days == 7 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.7") %>
      <% end %>
      <%= link_to user_impact_errors_path(days: 30), class: "btn btn-sm #{@days == 30 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.30") %>
      <% end %>
      <%= link_to user_impact_errors_path(days: 90), class: "btn btn-sm #{@days == 90 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.90") %>
      <% end %>
    </div>
  </div>

  <% if @entries.empty? %>
    <div class="red-empty-state">
      <i class="bi bi-people display-1 text-muted mb-3"></i>
      <div class="red-empty-state-title"><%= red_t("red.analytics.user_impact.empty.title") %></div>
      <p class="text-muted">
        <%= red_t("red.analytics.user_impact.empty.message", days: @days) %>
      </p>
      <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body text-start">
          <h6><%= red_t("red.analytics.user_impact.empty.how_tracked_title") %></h6>
          <ul class="mb-0">
            <li><%= red_t("red.analytics.user_impact.empty.step_user_id_html", attribute: content_tag(:code, "user_id")) %></li>
            <li><%= red_t("red.analytics.user_impact.empty.step_auto_html",
                           current_attributes: content_tag(:code, "CurrentAttributes"),
                           current_user: content_tag(:code, "current_user")) %></li>
            <li><%= red_t("red.analytics.user_impact.empty.step_config_html", option: content_tag(:code, 'config.user_model = "User"')) %></li>
          </ul>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Summary Cards -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-primary"><%= @summary[:total_error_types_with_users] %></div>
            <small class="text-muted"><%= red_t("red.analytics.user_impact.summary.error_types") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-danger"><%= @summary[:total_unique_users_affected] %></div>
            <small class="text-muted"><%= red_t("red.analytics.user_impact.summary.total_users_affected") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6"><code><%= @summary[:most_impactful] || red_t("red.common.not_available") %></code></div>
            <small class="text-muted"><%= red_t("red.analytics.user_impact.summary.most_impactful") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-info"><%= @summary[:total_users] ? number_with_delimiter(@summary[:total_users]) : red_t("red.common.not_available") %></div>
            <small class="text-muted"><%= red_t("red.analytics.user_impact.summary.total_users") %></small>
          </div>
        </div>
      </div>
    </div>

    <!-- User Impact Table -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="bi bi-bar-chart text-primary me-2"></i>
          <%= red_t("red.analytics.user_impact.table.title") %>
          <span class="badge bg-primary"><%= @summary[:total_error_types_with_users] %></span>
        </h5>
        <small class="text-muted"><%== @pagy.info_tag %></small>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th width="40"><%= red_t("red.analytics.user_impact.table.column_rank") %></th>
                <th><%= red_t("red.analytics.user_impact.table.column_error_type") %></th>
                <th width="120"><%= red_t("red.analytics.user_impact.table.column_unique_users") %></th>
                <th width="120"><%= red_t("red.analytics.user_impact.table.column_occurrences") %></th>
                <% if @summary[:total_users] %>
                  <th width="150"><%= red_t("red.analytics.user_impact.table.column_impact_percentage") %></th>
                <% end %>
                <th width="100"><%= red_t("red.analytics.user_impact.table.column_severity") %></th>
                <th width="140"><%= red_t("red.analytics.user_impact.table.column_last_seen") %></th>
                <th width="80"></th>
              </tr>
            </thead>
            <tbody>
              <% @entries.each_with_index do |entry, index| %>
                <tr>
                  <td><strong><%= (@pagy.from || 1) + index %></strong></td>
                  <td>
                    <%= link_to errors_path(error_type: entry[:error_type], unresolved: '0'), class: "text-decoration-none" do %>
                      <strong><%= entry[:error_type] %></strong>
                    <% end %>
                    <br><small class="text-muted"><%= entry[:message] %></small>
                  </td>
                  <td>
                    <span class="badge bg-danger"><%= red_tp("red.analytics.user_impact.table.users", count: entry[:unique_users]) %></span>
                  </td>
                  <td>
                    <span class="badge bg-secondary"><%= red_tp("red.analytics.user_impact.table.occurrences", count: entry[:total_occurrences]) %></span>
                  </td>
                  <% if @summary[:total_users] && entry[:impact_percentage] %>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height: 18px;">
                          <%
                            pct = entry[:impact_percentage]
                            bar_class = pct > 10 ? "bg-danger" : (pct > 5 ? "bg-warning" : "bg-info")
                          %>
                          <div class="progress-bar <%= bar_class %>" style="width: <%= [ pct, 100 ].min %>%;">
                            <%= pct %>%
                          </div>
                        </div>
                      </div>
                    </td>
                  <% end %>
                  <td>
                    <%
                      sev = entry[:severity].to_s
                      sev_class = case sev
                                  when "critical" then "bg-danger"
                                  when "high" then "bg-warning text-dark"
                                  when "medium" then "bg-info"
                                  else "bg-secondary"
                                  end
                    %>
                    <span class="badge <%= sev_class %>"><%= red_t("red.common.severity.#{sev}", default: sev) %></span>
                  </td>
                  <td><small><%= local_time_ago(entry[:last_seen]) %></small></td>
                  <td>
                    <% if entry[:id] %>
                      <%= link_to error_path(entry[:id]), class: "btn btn-sm btn-outline-primary" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer border-top d-flex justify-content-between align-items-center">
        <small class="text-muted">
          <i class="bi bi-info-circle"></i>
          <%= red_t("red.analytics.user_impact.table.footer") %>
        </small>
        <div>
          <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
        </div>
      </div>
    </div>
  <% end %>
</div>
