<%
  # Render value badge based on type
  case type
  when :boolean
    if value
%>
    <span class="badge bg-success fs-6">
      <i class="bi bi-check-circle"></i> <%= red_t("red.settings.values.enabled") %>
    </span>
<%
    else
%>
    <span class="badge bg-secondary fs-6">
      <i class="bi bi-x-circle"></i> <%= red_t("red.settings.values.disabled") %>
    </span>
<%
    end

  when :integer
    if value.present?
%>
    <%# The unit is a plural key driven by the value, not an English word
        appended to a number — position and form both vary by locale. %>
    <span class="badge bg-info fs-6"><%= unit ? red_tp("red.settings.units.#{unit}", count: value) : value %></span>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end

  when :float
    if value.present?
%>
    <span class="badge bg-info fs-6"><%= unit ? red_tp("red.settings.units.#{unit}", count: value) : value %></span>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end

  when :percentage
    if value.present?
%>
    <span class="badge bg-info fs-6"><%= (value * 100).to_i %>%</span>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end

  when :string
    if value.present?
%>
    <code class="fs-6"><%= value %></code>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end

  when :symbol
    if value.present?
%>
    <code class="fs-6">:<%= value %></code>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end

  when :url
    if value.present?
%>
    <code class="fs-6 text-truncate" style="max-width: 200px; display: inline-block;"><%= value %></code>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end

  when :array
    if value.present? && value.any?
%>
    <span class="badge bg-info fs-6"><%= red_tp("red.settings.values.items", count: value.count) %></span>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.empty") %></span>
<%
    end

  when :hash
    if value.present? && value.any?
%>
    <span class="badge bg-info fs-6"><%= red_tp("red.settings.values.rules", count: value.count) %></span>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.empty") %></span>
<%
    end

  when :git_sha
    if value.present?
%>
    <span class="fs-6"><%= git_commit_link(value) %></span>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end

  when :application_name
    # Show both configured and auto-detected application name
    configured_value = value
    auto_detected = defined?(Rails) ? Rails.application.class.module_parent_name : nil
    effective_value = configured_value.presence || auto_detected
    is_auto_detected = configured_value.blank? && auto_detected.present?

    if effective_value.present?
%>
    <div>
      <code class="fs-6"><%= effective_value %></code>
      <% if is_auto_detected %>
        <small class="text-success d-block">
          <i class="bi bi-magic"></i> <%= red_t("red.settings.values.auto_detected") %>
        </small>
      <% else %>
        <small class="text-muted d-block"><%= red_t("red.settings.values.configured") %></small>
      <% end %>
    </div>
<%
    else
%>
    <div>
      <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
      <small class="text-muted d-block"><%= red_t("red.settings.values.rails_app_name_unavailable") %></small>
    </div>
<%
    end

  when :database_name
    # Show the active database connection name
    begin
      if RailsErrorDashboard.configuration.use_separate_database
        # Using separate database
        db_config_name = RailsErrorDashboard.configuration.database || 'error_dashboard'
        db_config = ActiveRecord::Base.configurations.configs_for(env_name: Rails.env, name: db_config_name.to_s)
        if db_config
          db_name = db_config.database
          status_badge = 'bg-success'
          status_text = red_t("red.settings.values.separate_db", name: db_config_name)
        else
          db_name = db_config_name
          status_badge = 'bg-warning'
          status_text = red_t("red.settings.values.configured_but_not_found")
        end
      else
        # Using primary database
        db_config = ActiveRecord::Base.configurations.configs_for(env_name: Rails.env, name: 'primary')
        if db_config
          db_name = db_config.database
          status_badge = 'bg-info'
          status_text = red_t("red.settings.values.shared_db_primary")
        else
          # Fallback to current connection
          db_name = RailsErrorDashboard::ErrorLog.connection.current_database rescue red_t("red.settings.values.unknown")
          status_badge = 'bg-info'
          status_text = red_t("red.settings.values.shared_db")
        end
      end
%>
    <div>
      <span class="badge <%= status_badge %> fs-6"><%= File.basename(db_name.to_s) %></span>
      <small class="text-muted d-block"><%= status_text %></small>
    </div>
<%
    rescue => e
%>
    <div>
      <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.unknown") %></span>
      <small class="text-muted d-block"><%= red_t("red.settings.values.unable_to_detect") %></small>
    </div>
<%
    end

  when :user_model
    # Show both configured and auto-detected values
    configured_value = value
    effective_value = RailsErrorDashboard.configuration.effective_user_model
    is_auto_detected = configured_value.blank? && effective_value.present?

    if effective_value.present?
%>
    <div>
      <code class="fs-6"><%= effective_value %></code>
      <% if is_auto_detected %>
        <small class="text-success d-block">
          <i class="bi bi-magic"></i> <%= red_t("red.settings.values.auto_detected") %>
        </small>
      <% else %>
        <small class="text-muted d-block"><%= red_t("red.settings.values.configured") %></small>
      <% end %>
    </div>
<%
    else
%>
    <div>
      <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_found") %></span>
      <small class="text-muted d-block"><%= red_t("red.settings.values.no_user_model") %></small>
    </div>
<%
    end

  when :total_users
    # Show both configured and auto-detected values
    configured_value = value
    effective_value = RailsErrorDashboard.configuration.effective_total_users
    is_auto_detected = configured_value.blank? && effective_value.present?

    if effective_value.present?
%>
    <div>
      <span class="badge <%= is_auto_detected ? 'bg-success' : 'bg-info' %> fs-6"><%# count drives the plural form; the delimited number is what gets displayed,
          so both are passed and the key interpolates %{formatted}. %>
      <%= red_tp("red.settings.values.users", count: effective_value, formatted: number_with_delimiter(effective_value)) %></span>
      <% if is_auto_detected %>
        <small class="text-success d-block">
          <i class="bi bi-magic"></i> <%= red_t("red.settings.values.auto_detected") %>
        </small>
      <% else %>
        <small class="text-muted d-block"><%= red_t("red.settings.values.configured") %></small>
      <% end %>
    </div>
<%
    else
%>
    <div>
      <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_available") %></span>
      <small class="text-muted d-block"><%= red_t("red.settings.values.unable_to_query_count") %></small>
    </div>
<%
    end

  when :secret
    if value.present?
%>
    <span class="badge bg-success fs-6">
      <i class="bi bi-check-circle"></i> <%= red_t("red.settings.values.set") %>
    </span>
<%
    else
%>
    <span class="badge bg-warning text-dark fs-6">
      <i class="bi bi-exclamation-triangle"></i> <%= red_t("red.settings.values.not_set") %>
    </span>
<%
    end

  when :retention_days
    # Show retention configuration with manual cleanup instructions
    if value.present?
%>
    <div>
      <span class="badge bg-warning text-dark fs-6"><%= red_tp("red.settings.values.days", count: value) %></span>
      <small class="text-danger d-block">
        <i class="bi bi-exclamation-triangle"></i> <%= red_t("red.settings.values.manual_cleanup_required") %>
      </small>
      <small class="text-muted d-block mt-1">
        <%= red_t("red.settings.values.run_command") %> <code class="small">rails error_dashboard:cleanup_resolved DAYS=<%= value %></code>
      </small>
    </div>
<%
    else
%>
    <div>
      <span class="badge bg-success fs-6"><i class="bi bi-infinity"></i> <%= red_t("red.settings.values.keep_forever") %></span>
      <small class="text-muted d-block"><%= red_t("red.settings.values.no_automatic_deletion") %></small>
      <small class="text-muted d-block mt-1">
        <%= red_t("red.settings.values.to_cleanup") %> <code class="small">rails error_dashboard:cleanup_resolved DAYS=90</code>
      </small>
    </div>
<%
    end

  else
    # Default rendering
    if value.present?
%>
    <code class="fs-6"><%= value %></code>
<%
    else
%>
    <span class="badge bg-secondary fs-6"><%= red_t("red.settings.values.not_set") %></span>
<%
    end
  end
%>
