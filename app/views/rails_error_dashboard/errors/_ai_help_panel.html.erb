<div id="red-ai-help-backdrop" class="red-ai-help-backdrop" data-red-action="close-ai-help" hidden></div>

<aside id="red-ai-help-panel" class="red-ai-help-panel" aria-labelledby="red-ai-help-title" aria-hidden="true">
  <div class="red-ai-help-header">
    <div>
      <div id="red-ai-help-title" class="red-ai-help-title">
        <i class="bi bi-stars"></i>
        <%= red_t("red.errors.ai_help.title") %>
      </div>
      <div class="red-ai-help-subtitle">
        <%# Brand name, identical in every locale, but looked up rather than
            titleized: "openai".titleize is "Openai", which is not how the
            company writes it. An unknown provider falls back to its raw value. %>
        <% llm_provider = RailsErrorDashboard.configuration.effective_llm_provider %>
        <%= red_t("red.errors.ai_help.providers.#{llm_provider}", default: llm_provider.to_s) %>
        &middot;
        <%= RailsErrorDashboard.configuration.effective_llm_model %>
      </div>
    </div>
    <button type="button" class="btn-close" data-red-action="close-ai-help" aria-label="<%= red_t("red.errors.ai_help.close") %>"></button>
  </div>

  <div id="red-ai-help-messages" class="red-ai-help-messages" aria-live="polite">
    <div class="red-ai-help-empty">
      <%= red_t("red.errors.ai_help.empty") %>
    </div>
  </div>

  <form id="red-ai-help-form" class="red-ai-help-form" data-ai-help-url="<%= ai_help_error_path(error, **app_context) %>">
    <label for="red-ai-help-question"><%= red_t("red.errors.ai_help.question_label") %></label>
    <textarea id="red-ai-help-question" name="question" rows="4" maxlength="4000" placeholder="<%= red_t("red.errors.ai_help.question_placeholder") %>"></textarea>
    <div class="red-ai-help-footer">
      <span id="red-ai-help-status" class="red-ai-help-status"></span>
      <button type="submit" class="btn btn-primary">
        <i class="bi bi-send"></i>
        <%= red_t("red.errors.ai_help.ask") %>
      </button>
    </div>
  </form>
</aside>
