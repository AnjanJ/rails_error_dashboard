<% content_for :page_title, red_t("red.errors.rack_attack_page.title") %>

<div>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size: 20px; font-weight: 700; margin: 0;">
      <i class="bi bi-shield-exclamation me-2"></i>
      <%= red_t("red.errors.rack_attack_page.title") %>
    </h1>

    <div class="btn-group" role="group">
      <%= link_to rack_attack_summary_errors_path(days: 7), class: "btn btn-sm #{@days == 7 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.7") %>
      <% end %>
      <%= link_to rack_attack_summary_errors_path(days: 30), class: "btn btn-sm #{@days == 30 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.30") %>
      <% end %>
      <%= link_to rack_attack_summary_errors_path(days: 90), class: "btn btn-sm #{@days == 90 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.90") %>
      <% end %>
    </div>
  </div>

  <% if @unique_rules == 0 %>
    <div class="red-empty-state">
      <% if @rack_attack_missing %>
        <i class="bi bi-exclamation-triangle display-1 text-warning mb-3"></i>
        <div class="red-empty-state-title"><%= red_t("red.errors.rack_attack_page.missing_title") %></div>
        <p class="text-muted">
          <%= red_t("red.errors.rack_attack_page.missing_body_html", gem: content_tag(:code, "rack-attack")) %>
        </p>
      <% else %>
        <i class="bi bi-shield-check display-1 text-success mb-3"></i>
        <div class="red-empty-state-title"><%= red_t("red.errors.rack_attack_page.empty_title") %></div>
        <p class="text-muted">
          <%= red_t("red.errors.rack_attack_page.empty_body", days: @days) %>
        </p>
      <% end %>
      <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body text-start">
          <h6><%= red_t("red.errors.rack_attack_page.how_title") %></h6>
          <ul class="mb-0">
            <li><%= red_t("red.errors.rack_attack_page.how_enabled_html", option: content_tag(:code, "enable_rack_attack_tracking = true")) %></li>
            <li><%= red_t("red.errors.rack_attack_page.how_installed") %></li>
            <li><%= red_t("red.errors.rack_attack_page.how_recorded") %></li>
            <li><%= red_t("red.errors.rack_attack_page.how_buffered", seconds: RailsErrorDashboard.configuration.rack_attack_flush_interval) %></li>
          </ul>
        </div>
      </div>
    </div>
  <% else %>
    <div class="row mb-4">
      <div class="col-md-4">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-warning"><%= @unique_rules %></div>
            <small class="text-muted"><%= red_t("red.errors.rack_attack_page.unique_rules") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-danger"><%= @total_events %></div>
            <small class="text-muted"><%= red_t("red.errors.rack_attack_page.total_events") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-info"><%= @unique_ips %></div>
            <small class="text-muted"><%= red_t("red.errors.rack_attack_page.unique_ips") %></small>
          </div>
        </div>
      </div>
    </div>

    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="bi bi-shield-exclamation text-warning me-2"></i>
          <%= red_t("red.errors.rack_attack_page.all_title") %>
          <span class="badge bg-warning text-dark"><%= @unique_rules %></span>
        </h5>
        <small class="text-muted"><%== @pagy.info_tag %></small>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th><%= red_t("red.errors.rack_attack_page.column_rule") %></th>
                <th width="100"><%= red_t("red.errors.rack_attack_page.column_type") %></th>
                <th width="80"><%= red_t("red.errors.rack_attack_page.column_count") %></th>
                <th width="80"><%= red_t("red.errors.rack_attack_page.column_ips") %></th>
                <th><%= red_t("red.errors.rack_attack_page.column_top_path") %></th>
                <th width="140"><%= red_t("red.errors.pages.column_last_seen") %></th>
              </tr>
            </thead>
            <tbody>
              <% @events.each do |event| %>
                <tr>
                  <td><code><%= event[:rule] %></code></td>
                  <td>
                    <% type_color = case event[:match_type]
                       when "blocklist" then "danger"
                       when "throttle" then "warning"
                       else "secondary"
                       end %>
                    <%# The match type is a machine value the case above compares
                        by string equality, so the comparison keeps the English
                        literal and only the display goes through a key. %>
                    <span class="badge bg-<%= type_color %>"><%= red_t("red.errors.rack_attack_page.match_type.#{event[:match_type]}") %></span>
                  </td>
                  <td><strong><%= event[:count] %></strong></td>
                  <td><%= event[:unique_ips] %></td>
                  <td><code><%= event[:top_path] %></code></td>
                  <td><%= local_time_ago(event[:last_seen]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer border-top d-flex justify-content-between align-items-center">
        <div>
          <small class="text-muted">
            <i class="bi bi-lightbulb text-warning"></i> <%= red_t("red.errors.rack_attack_page.footer_tip") %>
          </small>
          <small class="ms-3">
            <a href="https://github.com/rack/rack-attack" target="_blank" rel="noopener" class="text-decoration-none">
              <i class="bi bi-book"></i> <%= red_t("red.errors.rack_attack_page.docs") %> <i class="bi bi-box-arrow-up-right" style="font-size: 0.7em;"></i>
            </a>
          </small>
        </div>
        <div>
          <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
        </div>
      </div>
    </div>
  <% end %>
</div>
