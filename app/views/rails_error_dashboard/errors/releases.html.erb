<% content_for :page_title, red_t("red.analytics.releases.title") %>

<div>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size: 20px; font-weight: 700; margin: 0;">
      <i class="bi bi-rocket-takeoff me-2"></i>
      <%= red_t("red.analytics.releases.title") %>
    </h1>

    <div class="btn-group" role="group">
      <%= link_to releases_errors_path(days: 7), class: "btn btn-sm #{@days == 7 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.7") %>
      <% end %>
      <%= link_to releases_errors_path(days: 30), class: "btn btn-sm #{@days == 30 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.30") %>
      <% end %>
      <%= link_to releases_errors_path(days: 90), class: "btn btn-sm #{@days == 90 ? 'btn-primary' : 'btn-outline-primary'}" do %>
        <%= red_t("red.common.days_filter.90") %>
      <% end %>
    </div>
  </div>

  <% if @releases.empty? %>
    <div class="red-empty-state">
      <i class="bi bi-rocket-takeoff display-1 text-muted mb-3"></i>
      <div class="red-empty-state-title"><%= red_t("red.analytics.releases.empty.title") %></div>
      <p class="text-muted">
        <%= red_t("red.analytics.releases.empty.message", days: @days) %>
      </p>
      <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body text-start">
          <h6><%= red_t("red.analytics.releases.empty.how_to_title") %></h6>
          <ul class="mb-0">
            <li><%= red_t("red.analytics.releases.empty.step_config_html", option: content_tag(:code, "config.app_version")) %></li>
            <li><%= red_t("red.analytics.releases.empty.step_env_html", env_var: content_tag(:code, "APP_VERSION")) %></li>
            <li><%= red_t("red.analytics.releases.empty.step_git_sha_html",
                           git_sha: content_tag(:code, "GIT_SHA"), heroku: content_tag(:code, "HEROKU_SLUG_COMMIT"),
                           render: content_tag(:code, "RENDER_GIT_COMMIT")) %></li>
            <li><%= red_t("red.analytics.releases.empty.step_captured") %></li>
          </ul>
        </div>
      </div>
    </div>
  <% else %>
    <%
      current_release = @releases.find { |r| r[:current] }
    %>

    <!-- Summary Cards -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-primary"><%= @summary[:total_releases] %></div>
            <small class="text-muted"><%= red_t("red.analytics.releases.summary.releases") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6"><code><%= @summary[:current_version] || red_t("red.common.not_available") %></code></div>
            <small class="text-muted"><%= red_t("red.analytics.releases.summary.current_release") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <div class="display-6 text-warning"><%= @summary[:avg_errors_per_release] %></div>
            <small class="text-muted"><%= red_t("red.analytics.releases.summary.avg_errors") %></small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <%
              problematic_count = @releases.count { |r| r[:problematic] }
            %>
            <div class="display-6 <%= problematic_count > 0 ? 'text-danger' : 'text-success' %>"><%= problematic_count %></div>
            <small class="text-muted"><%= red_t("red.analytics.releases.summary.problematic") %></small>
          </div>
        </div>
      </div>
    </div>

    <% if current_release %>
      <!-- Current Release Card -->
      <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i class="bi bi-broadcast"></i> <%= red_t("red.analytics.releases.current_card.title") %> <strong><%= current_release[:version] %></strong>
          </h5>
          <span class="badge bg-light text-primary"><%= red_t("red.analytics.releases.current_card.live_badge") %></span>
        </div>
        <div class="card-body">
          <div class="row text-center">
            <div class="col-md-2">
              <div class="h4 mb-0"><%= current_release[:total_errors] %></div>
              <small class="text-muted"><%= red_t("red.analytics.releases.current_card.errors") %></small>
            </div>
            <div class="col-md-2">
              <div class="h4 mb-0"><%= current_release[:unique_error_types] %></div>
              <small class="text-muted"><%= red_t("red.analytics.releases.current_card.error_types") %></small>
            </div>
            <div class="col-md-2">
              <div class="h4 mb-0">
                <% if current_release[:new_error_count] > 0 %>
                  <span class="text-danger"><%= current_release[:new_error_count] %></span>
                <% else %>
                  <span class="text-success">0</span>
                <% end %>
              </div>
              <small class="text-muted"><%= red_t("red.analytics.releases.current_card.new_errors") %></small>
            </div>
            <div class="col-md-2">
              <%
                stability_color = case current_release[:stability]
                                  when :green then "success"
                                  when :yellow then "warning"
                                  when :red then "danger"
                                  else "secondary"
                                  end
              %>
              <div class="h4 mb-0">
                <span class="badge bg-<%= stability_color %>">
                  <%= red_t("red.analytics.stability.#{current_release[:stability]}", default: current_release[:stability].to_s) %>
                </span>
              </div>
              <small class="text-muted"><%= red_t("red.analytics.releases.current_card.stability") %></small>
            </div>
            <div class="col-md-2">
              <% if current_release[:git_shas].any? %>
                <div class="h4 mb-0"><%= git_commit_link(current_release[:git_shas].first) %></div>
              <% else %>
                <div class="h4 mb-0 text-muted"><%= red_t("red.common.not_available") %></div>
              <% end %>
              <small class="text-muted"><%= red_t("red.analytics.releases.current_card.git_sha") %></small>
            </div>
            <div class="col-md-2">
              <% if current_release[:delta_from_previous] %>
                <%
                  delta = current_release[:delta_from_previous]
                  delta_class = delta > 0 ? "text-danger" : (delta < 0 ? "text-success" : "text-muted")
                  delta_icon = delta > 0 ? "bi-arrow-up" : (delta < 0 ? "bi-arrow-down" : "bi-dash")
                %>
                <div class="h4 mb-0 <%= delta_class %>">
                  <i class="bi <%= delta_icon %>"></i> <%= delta.abs %>
                </div>
              <% else %>
                <div class="h4 mb-0 text-muted">&mdash;</div>
              <% end %>
              <small class="text-muted"><%= red_t("red.analytics.releases.current_card.vs_previous") %></small>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Release Timeline Table -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          <i class="bi bi-clock-history text-primary me-2"></i>
          <%= red_t("red.analytics.releases.timeline.title") %>
          <span class="badge bg-primary"><%= @summary[:total_releases] %></span>
        </h5>
        <small class="text-muted"><%== @pagy.info_tag %></small>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th><%= red_t("red.analytics.releases.timeline.column_version") %></th>
                <th><%= red_t("red.analytics.releases.timeline.column_git_sha") %></th>
                <th><%= red_t("red.analytics.releases.timeline.column_time_range") %></th>
                <th width="100"><%= red_t("red.analytics.releases.timeline.column_errors") %></th>
                <th width="100"><%= red_t("red.analytics.releases.timeline.column_types") %></th>
                <th width="120"><%= red_t("red.analytics.releases.timeline.column_new_errors") %></th>
                <th width="100"><%= red_t("red.analytics.releases.timeline.column_stability") %></th>
                <th width="120"><%= red_t("red.analytics.releases.timeline.column_vs_previous") %></th>
              </tr>
            </thead>
            <tbody>
              <% @releases.each do |release| %>
                <tr class="<%= 'table-active' if release[:current] %>">
                  <td>
                    <%= link_to errors_path(app_version: release[:version], unresolved: '0'), class: "text-decoration-none" do %>
                      <strong><%= release[:version] %></strong>
                    <% end %>
                    <% if release[:current] %>
                      <span class="badge bg-primary ms-1"><%= red_t("red.analytics.releases.timeline.current_badge") %></span>
                    <% end %>
                    <% if release[:problematic] %>
                      <span class="badge bg-danger ms-1"><%= red_t("red.analytics.releases.timeline.problematic_badge") %></span>
                    <% end %>
                  </td>
                  <td>
                    <% if release[:git_shas].any? %>
                      <%= git_commit_link(release[:git_shas].first) %>
                      <% if release[:git_shas].size > 1 %>
                        <small class="text-muted"><%= red_t("red.analytics.releases.timeline.more_shas", count: release[:git_shas].size - 1) %></small>
                      <% end %>
                    <% else %>
                      <span class="text-muted"><%= red_t("red.common.not_available") %></span>
                    <% end %>
                  </td>
                  <td>
                    <small>
                      <%= local_time_ago(release[:first_seen]) %>
                      <% unless release[:first_seen] == release[:last_seen] %>
                        &rarr; <%= local_time_ago(release[:last_seen]) %>
                      <% end %>
                    </small>
                  </td>
                  <td>
                    <span class="badge bg-secondary"><%= release[:total_errors] %></span>
                  </td>
                  <td>
                    <span class="badge bg-info"><%= release[:unique_error_types] %></span>
                  </td>
                  <td>
                    <% if release[:new_error_count] > 0 %>
                      <span class="badge bg-danger">
                        <i class="bi bi-exclamation-circle"></i> <%= red_tp("red.analytics.releases.timeline.new_count", count: release[:new_error_count]) %>
                      </span>
                    <% else %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-circle"></i> <%= red_tp("red.analytics.releases.timeline.new_count", count: 0) %>
                      </span>
                    <% end %>
                  </td>
                  <td>
                    <%
                      stability_color = case release[:stability]
                                        when :green then "success"
                                        when :yellow then "warning"
                                        when :red then "danger"
                                        else "secondary"
                                        end
                    %>
                    <span class="badge bg-<%= stability_color %>">
                      <i class="bi bi-circle-fill" style="font-size: 0.5em; vertical-align: middle;"></i>
                      <%= red_t("red.analytics.stability.#{release[:stability]}", default: release[:stability].to_s) %>
                    </span>
                  </td>
                  <td>
                    <% if release[:delta_from_previous] %>
                      <%
                        delta = release[:delta_from_previous]
                        pct = release[:delta_percentage]
                        delta_class = delta > 0 ? "text-danger" : (delta < 0 ? "text-success" : "text-muted")
                        delta_icon = delta > 0 ? "bi-arrow-up" : (delta < 0 ? "bi-arrow-down" : "bi-dash")
                      %>
                      <span class="<%= delta_class %>">
                        <i class="bi <%= delta_icon %>"></i>
                        <%= delta > 0 ? "+#{delta}" : delta %>
                        <% if pct %>
                          <small>(<%= pct > 0 ? "+#{pct}" : pct %>%)</small>
                        <% end %>
                      </span>
                    <% else %>
                      <span class="text-muted">&mdash;</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer border-top d-flex justify-content-between align-items-center">
        <small class="text-muted">
          <i class="bi bi-info-circle"></i>
          <%= red_t("red.analytics.releases.timeline.footer_html") %>
        </small>
        <div>
          <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
        </div>
      </div>
    </div>
  <% end %>
</div>
